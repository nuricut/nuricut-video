{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.nuricut.video" }],
      "destination": "https://nuricut.video/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
